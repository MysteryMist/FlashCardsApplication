    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET MAUI (Android Emulator)",
            "type": "maui",
            "request": "launch",
            "targetFramework": "net10.0-android",
            "project": "${workspaceFolder}/FlashCardsApp/FlashCardsApp.csproj",
            "preLaunchTask": "maui: Build",
            "buildConfiguration": "Debug",
            "deviceId": "emulator"
        },
        {
            "name": ".NET MAUI (Windows Desktop)",
            "type": "maui",
            "request": "launch",
            "targetFramework": "net10.0-windows10.0.19041.0",
            "project": "${workspaceFolder}/FlashCardsApp/FlashCardsApp.csproj",
            "preLaunchTask": "maui: Build",
            "buildConfiguration": "Debug"
        }
    ]
}